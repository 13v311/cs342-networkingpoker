<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.uic.cs342.client.ClientController"
      alignment="CENTER" spacing="16" styleClass="screen">
  <Label text="Three Card Poker — Game" styleClass="title"/>
  <Label text="Connection status and current game state"/>
  <HBox alignment="CENTER" spacing="12">
    <Label text="Ante:"/><TextField promptText="5–25" prefWidth="90"/>
    <Label text="Pair Plus:"/><TextField promptText="Optional" prefWidth="100"/>
  </HBox>
  <Label text="Player cards will be displayed here"/>
  <HBox spacing="12">
    <Button text="Play" onAction="#handlePlay"/>
    <Button text="Fold" onAction="#handleFold"/>
    <Button text="View Results" onAction="#showResultsScreen"/>
  </HBox>
  <Button text="Back to Connection" onAction="#showConnectionScreen"/>
</VBox>
