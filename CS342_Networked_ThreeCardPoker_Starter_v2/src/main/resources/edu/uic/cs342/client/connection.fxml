<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.uic.cs342.client.ClientController"
      alignment="CENTER" spacing="14" styleClass="screen">
  <Label text="Three Card Poker" styleClass="title"/>
  <Label text="Connect to a game server" styleClass="subtitle"/>
  <GridPane hgap="10" vgap="10" maxWidth="390">
    <Label text="Server host:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="hostField" text="localhost" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Port:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="portField" text="5555" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Player name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="playerNameField" promptText="Enter your name" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
  </GridPane>
  <Button text="Connect" onAction="#handleConnect" styleClass="primary-button"/>
  <Label fx:id="statusLabel" text="Not connected"/>
</VBox>
